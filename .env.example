# Audit form delivery. Leave blank until you have a real value.
# How to get each one: README, "Audit form delivery".
# Do not commit a filled copy of this file.

# Resend API key. Emails a valid audit submission to clabonge@adtell.ai.
RESEND_API_KEY=

# Optional sender. Default is Adtell.ai <onboarding@resend.dev>.
# After adtell.ai is verified in Resend: Adtell.ai <audit@adtell.ai>
RESEND_FROM=

# Optional HTTPS URL. Used when RESEND_API_KEY is unset or Resend fails.
AUDIT_WEBHOOK_URL=
