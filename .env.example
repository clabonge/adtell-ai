# Copy to .env.local for local work. Do not commit a filled copy.
# Full setup: docs/crm.md

# Postgres connection string. Example for a local database only:
# DATABASE_URL=postgres://adtell:adtell@127.0.0.1:5432/adtell
DATABASE_URL=

# Owner CRM. There is no default password.
# Create the hash with: npm run crm:hash-password
# CRM_SESSION_SECRET must be at least 32 characters.
CRM_SESSION_SECRET=
CRM_OWNER_EMAIL=
CRM_OWNER_PASSWORD_HASH=

# Optional public scheduling link. Leave blank to hide "Book a free 30-minute audit call".
# Read at build time. Use an https URL.
NEXT_PUBLIC_BOOKING_URL=

# Optional rate limits for the public audit form. Defaults are 3 per minute and 10 per hour.
# CRM_RATE_PER_MINUTE=3
# CRM_RATE_PER_HOUR=10

# Notification channels. Each configured channel gets its own job.
# Leave blank until you have a real value.
RESEND_API_KEY=
RESEND_FROM=
AUDIT_WEBHOOK_URL=

# Development only. Never set this on Render.
# CRM_SEED_DEMO=1
